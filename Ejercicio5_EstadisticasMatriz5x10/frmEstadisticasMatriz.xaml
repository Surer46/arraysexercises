<Window x:Class="Ejercicio5_EstadisticasMatriz5x10.frmEstadisticasMatriz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 5 - Matriz 5x10 con Sumas y Promedios (Arreglos A, B, C, D)" 
        Height="800" Width="1160" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        MinWidth="1050" MinHeight="720">

    <Window.Resources>
        <Style x:Key="BtnPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecundarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1FAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPeligroStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CupertinoCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.05" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CeldaInputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CupertinoCard}" Margin="0,0,0,18" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Material Tabla y Estadísticas -->
                        <Path Fill="#10B981" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M10 10.02h5V21h-5zM17 21h5V10h-5v11zm5-18H3c-1.1 0-2 .9-2 2v3h22V5c0-1.1-.9-2-2-2zM2 19c0 1.1.9 2 2 2h4V10H2v9z"/>
                        <TextBlock x:Name="lblTitulo" Text="Ejercicio 5: Matriz 5x10 con Suma y Promedio (Arreglos A, B, C, D)" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock x:Name="lblSubtitulo" Text="Llena una matriz de 5x10 y almacena: A = Suma de filas, B = Promedio de filas, C = Suma de columnas, D = Promedio de columnas." 
                               FontSize="13" Foreground="#64748B" Margin="34,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnCargarPDF" Click="btnCargarPDF_Click" 
                            Style="{StaticResource BtnSecundarioStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#065F46" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                            <TextBlock Text="Cargar Ejemplo PDF"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAleatorio" Click="btnAleatorio_Click" 
                            Style="{StaticResource BtnSecundarioStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#065F46" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                            <TextBlock Text="Aleatorio"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnLimpiar" Click="btnLimpiar_Click" 
                            Style="{StaticResource BtnPeligroStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                            <TextBlock Text="Limpiar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO: TABLA PRINCIPAL Y PANEL LATERAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7.2*"/>
                <ColumnDefinition Width="2.8*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLERO MATRICIAL CON ARREGLOS LATERALES (A, B) E INFERIORES (C, D) -->
            <Border Grid.Column="0" Style="{StaticResource CupertinoCard}" Margin="0,0,12,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="Formato Oficial del PDF" FontWeight="Bold" FontSize="12" Foreground="#047857"/>
                        </Border>
                        <TextBlock Text="Matriz (5x10) | Derecha: A (Suma), B (Promedio) | Abajo: C (Suma), D (Promedio)" 
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Cuadrícula interactiva -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="14" Padding="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="gridTablaCompleta" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Se construye dinámicamente con inputs de la matriz y celdas de A, B, C, D -->
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Botón Calcular -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Button x:Name="btnCalcular" Click="btnCalcular_Click" 
                                Style="{StaticResource BtnPrimarioStyle}" Height="44" FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                      Data="M8 5v14l11-7z"/>
                                <TextBlock Text="Calcular Sumas y Promedios (Arreglos A, B, C, D)" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- PANEL DE RESUMEN -->
            <Border Grid.Column="1" Style="{StaticResource CupertinoCard}" Margin="12,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Resumen de Arreglos" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Tarjeta Suma Total -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SUMA TOTAL DE MATRIZ" FontSize="11" FontWeight="Bold" Foreground="#065F46" Opacity="0.8"/>
                                    <TextBlock x:Name="lblSumaTotal" Text="247" FontSize="24" FontWeight="Bold" Foreground="#047857"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PROMEDIO GENERAL" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock x:Name="lblPromedioGeneral" Text="4.94" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,6"/>
                                <TextBlock Text="Calculado como (Suma Total) / 50 celdas." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- Explicación de los Arreglos A, B, C, D -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ESTRUCTURA DE DATOS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="Arreglos Vectoriales A, B, C, D" 
                                           FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,6"/>
                                <TextBlock Text="• Arreglo A [5]: Suma de cada una de las 5 filas.&#x0a;• Arreglo B [5]: Promedio de cada una de las 5 filas (A[i] / 10).&#x0a;• Arreglo C [10]: Suma de cada una de las 10 columnas.&#x0a;• Arreglo D [10]: Promedio de cada columna (C[j] / 5)." 
                                           FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BARRA INFERIOR -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Listo. Puedes modificar cualquier casilla o generar valores aleatorios." 
                           FontSize="12" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
