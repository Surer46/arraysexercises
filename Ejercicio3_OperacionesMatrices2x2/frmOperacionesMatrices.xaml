<Window x:Class="Ejercicio3_OperacionesMatrices2x2.frmOperacionesMatrices"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 3 - Operaciones Básicas con Matrices 2x2" 
        Height="780" Width="1080" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        MinWidth="960" MinHeight="700">

    <Window.Resources>
        <Style x:Key="BtnPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecundarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1FAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPeligroStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CupertinoCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.05" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputMatrizStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="10" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="border" Property="Background" Value="#ECFDF5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CeldaResultadoStyle" TargetType="Border">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Height" Value="46"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CupertinoCard}" Margin="0,0,0,18" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Material Operaciones Matrices -->
                        <Path Fill="#10B981" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14H7v-2h5v2zm0-4H7v-2h5v2zm0-4H7V7h5v2zm5 8h-3v-3h-2v3h-3v2h3v3h2v-3h3v-2z"/>
                        <TextBlock x:Name="lblTitulo" Text="Ejercicio 3: Operaciones con Matrices 2x2" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock x:Name="lblSubtitulo" Text="Calcula suma, resta, producto simple y división simple término a término entre dos matrices 2x2." 
                               FontSize="13" Foreground="#64748B" Margin="34,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnCargarPDF" Click="btnCargarPDF_Click" 
                            Style="{StaticResource BtnSecundarioStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#065F46" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                            <TextBlock Text="Cargar Ejemplo PDF"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnLimpiar" Click="btnLimpiar_Click" 
                            Style="{StaticResource BtnPeligroStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                            <TextBlock Text="Limpiar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Matrices de Entrada -->
                <ColumnDefinition Width="4*"/>
                <!-- Resultados de las 4 operaciones -->
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: ENTRADA DE MATRIZ 1 Y MATRIZ 2 -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <!-- Matriz 1 -->
                <Border Style="{StaticResource CupertinoCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="Matriz 1" FontWeight="Bold" FontSize="13" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Valores entrada [A]" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52"/>
                                <RowDefinition Height="52"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtA00" Grid.Row="0" Grid.Column="0" Text="10" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                            <TextBox x:Name="txtA01" Grid.Row="0" Grid.Column="1" Text="5" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                            <TextBox x:Name="txtA10" Grid.Row="1" Grid.Column="0" Text="8" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                            <TextBox x:Name="txtA11" Grid.Row="1" Grid.Column="1" Text="2" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Matriz 2 -->
                <Border Style="{StaticResource CupertinoCard}" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="Matriz 2" FontWeight="Bold" FontSize="13" Foreground="#1D4ED8"/>
                            </Border>
                            <TextBlock Text="Valores entrada [B]" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52"/>
                                <RowDefinition Height="52"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtB00" Grid.Row="0" Grid.Column="0" Text="2" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                            <TextBox x:Name="txtB01" Grid.Row="0" Grid.Column="1" Text="4" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                            <TextBox x:Name="txtB10" Grid.Row="1" Grid.Column="0" Text="6" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                            <TextBox x:Name="txtB11" Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource InputMatrizStyle}" Margin="4"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Botón de Ejecutar -->
                <Button x:Name="btnCalcular" Click="btnCalcular_Click" 
                        Style="{StaticResource BtnPrimarioStyle}" Height="46" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <Path Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                              Data="M8 5v14l11-7z"/>
                        <TextBlock Text="Calcular las 4 Operaciones" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- COLUMNA DERECHA: TARJETAS DE RESULTADOS DE LAS 4 OPERACIONES -->
            <Border Grid.Column="1" Style="{StaticResource CupertinoCard}" Margin="12,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Resultados de las Operaciones" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <!-- Cuadrícula 2x2 de tarjetas con las 4 operaciones requeridas -->
                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- a) La suma -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                    CornerRadius="14" Padding="14" Margin="0,0,8,12">
                                <StackPanel>
                                    <TextBlock Text="a) La suma es (A + B):" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblSum00" Text="12" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblSum01" Text="9" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblSum10" Text="14" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblSum11" Text="10" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- b) La resta -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                    CornerRadius="14" Padding="14" Margin="8,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="b) La resta es (A - B):" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblRes00" Text="8" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblRes01" Text="1" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblRes10" Text="2" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblRes11" Text="-6" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- c) El producto -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                    CornerRadius="14" Padding="14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="c) El producto es (A · B):" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblProd00" Text="20" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblProd01" Text="20" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblProd10" Text="48" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblProd11" Text="16" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- d) La división -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                    CornerRadius="14" Padding="14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="d) La división es (A / B):" FontWeight="Bold" FontSize="13" Foreground="#047857" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblDiv00" Text="5" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblDiv01" Text="1.25" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblDiv10" Text="1.33" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CeldaResultadoStyle}">
                                            <TextBlock x:Name="lblDiv11" Text="0.25" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Explicación pedagógica -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="MÉTODOS EN SERVICIO SEPARADO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="Matrices2x2Service: Sumar, Restar, ProductoSimple, DivisionSimple" 
                                           FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,6"/>
                                <TextBlock Text="Cada método procesa la operación aritmética componente por componente utilizando dos ciclos for (i, j). Se valida la división por cero para prevenir errores numéricos." 
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Listo. Puedes modificar cualquier elemento de las matrices." 
                           FontSize="12" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
