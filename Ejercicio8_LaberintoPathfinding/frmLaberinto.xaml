<Window x:Class="Ejercicio8_LaberintoPathfinding.frmLaberinto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 8 - Pathfinding en Matriz 2D (Búsqueda de Caminos con Arreglos)" 
        Height="820" Width="1160" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        MinWidth="1050" MinHeight="740">

    <Window.Resources>
        <Style x:Key="BtnPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecundarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1FAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPeligroStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CupertinoCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.05" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CupertinoCard}" Margin="0,0,0,18" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Material Laberinto / Ruta -->
                        <Path Fill="#10B981" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                        <TextBlock x:Name="lblTitulo" Text="Ejercicio 8 (Nivel Alto): Pathfinding en Matriz 2D" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock x:Name="lblSubtitulo" Text="Búsqueda del camino óptimo en una cuadrícula con obstáculos usando matrices de estados, distancias y backtracking." 
                               FontSize="13" Foreground="#64748B" Margin="34,4,0,0"/>
                </StackPanel>

                <!-- Badge Nivel Alto -->
                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" 
                        CornerRadius="20" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="Nivel Avanzado - Puntos Extra 10/10" FontSize="12" FontWeight="SemiBold" Foreground="#047857"/>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLERO DEL LABERINTO -->
            <Border Grid.Column="0" Style="{StaticResource CupertinoCard}" Margin="0,0,12,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Button x:Name="btnGenerarAleatorio" Click="btnGenerarAleatorio_Click" 
                                Style="{StaticResource BtnSecundarioStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#065F46" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                      Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                <TextBlock Text="Generar Laberinto"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnLimpiarMuros" Click="btnLimpiarMuros_Click" 
                                Style="{StaticResource BtnPeligroStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                      Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                <TextBlock Text="Despejar Muros"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Haz clic en cualquier celda para poner o quitar muros" 
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <!-- Cuadrícula interactiva -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="14" Padding="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="gridLaberinto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Generado en código -->
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Botón Resolver -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Button x:Name="btnResolver" Click="btnResolver_Click" 
                                Style="{StaticResource BtnPrimarioStyle}" Height="46" FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                      Data="M8 5v14l11-7z"/>
                                <TextBlock Text="Buscar Ruta Óptima (BFS)" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- PANEL DE RESULTADOS Y RUTA -->
            <Border Grid.Column="1" Style="{StaticResource CupertinoCard}" Margin="12,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Estado del Algoritmo" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Tarjeta de Estado de la Ruta -->
                        <Border x:Name="cardEstadoRuta" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" 
                                CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="lblEstadoHeader" Text="ESTADO DE LA BÚSQUEDA" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                                <TextBlock x:Name="lblEstadoRuta" Text="¡Ruta Encontrada!" FontSize="20" FontWeight="Bold" Foreground="#047857" Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Longitud Ruta:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="lblLongitudRuta" Text="15 pasos" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Nodos Explorados:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="lblNodosExplorados" Text="28 celdas" FontSize="16" FontWeight="Bold" Foreground="#334155"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Secuencia de Coordenadas -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SECUENCIA DE COORDENADAS" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="lblCoordenadas" Text="[1,1] → [1,2] → [2,2]..." FontSize="12" FontFamily="Consolas" Foreground="#0F172A" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Leyenda de colores -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="LEYENDA DEL MAPA" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#10B981" Margin="0,0,8,0"/>
                                    <TextBlock Text="Punto Inicio [A] / Destino [B]" FontSize="12" Foreground="#334155"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#334155" Margin="0,0,8,0"/>
                                    <TextBlock Text="Muro / Obstáculo Bloqueado" FontSize="12" Foreground="#334155"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="16" Height="16" CornerRadius="4" Background="#D1FAE5" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="Camino Óptimo Encontrado" FontSize="12" Foreground="#334155"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Explicación pedagógica -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="MÉTODO UTILIZADO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="LaberintoService.EncontrarRutaOptima()" 
                                           FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,4"/>
                                <TextBlock Text="Algoritmo BFS que utiliza arreglos bidimensionales: matriz de visitados bool[,] y matriz de padres (int,int)[,] para reconstruir la ruta más corta garantizada desde el destino hacia el origen." 
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Listo. Puedes hacer clic en las casillas para agregar o quitar obstáculos." 
                           FontSize="12" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
