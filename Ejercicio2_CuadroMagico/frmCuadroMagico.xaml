<Window x:Class="Ejercicio2_CuadroMagico.frmCuadroMagico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 2 - Verificador y Generador de Cuadrado Mágico" 
        Height="760" Width="1060" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        MinWidth="950" MinHeight="700">

    <Window.Resources>
        <Style x:Key="BtnPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecundarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1FAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPeligroStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CupertinoCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.05" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CupertinoCard}" Margin="0,0,0,18" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Material Cuadrado / Magia -->
                        <Path Fill="#10B981" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
                        <TextBlock x:Name="lblTitulo" Text="Ejercicio 2: Cuadrado Mágico" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock x:Name="lblSubtitulo" Text="Verifica si una matriz cumple la propiedad de filas, columnas y diagonales con igual suma y halla la constante mágica." 
                               FontSize="13" Foreground="#64748B" Margin="34,4,0,0"/>
                </StackPanel>

                <!-- Selector de Dimensión NxN -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tamaño N:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                    <Border Background="#F1F5F9" CornerRadius="12" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rb3x3" Content="3 x 3" IsChecked="True" Checked="Tamano_Changed" Margin="4,2" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <RadioButton x:Name="rb4x4" Content="4 x 4" Checked="Tamano_Changed" Margin="4,2" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <RadioButton x:Name="rb5x5" Content="5 x 5" Checked="Tamano_Changed" Margin="4,2" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLERO MATRICIAL CON SUMAS LATERALES E INFERIORES -->
            <Border Grid.Column="0" Style="{StaticResource CupertinoCard}" Margin="0,0,12,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Acciones Superiores -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Button x:Name="btnCargarPDF" Click="btnCargarPDF_Click" 
                                Style="{StaticResource BtnSecundarioStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#065F46" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                      Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                                <TextBlock Text="Ejemplo PDF (3x3)"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnGenerarMagico" Click="btnGenerarMagico_Click" 
                                Style="{StaticResource BtnSecundarioStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#065F46" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                      Data="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6.4-4.8-6.4 4.8 2.4-7.2-6-4.8h7.6z"/>
                                <TextBlock Text="Auto-Generar Válido"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnLimpiar" Click="btnLimpiar_Click" 
                                Style="{StaticResource BtnPeligroStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                      Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                <TextBlock Text="Limpiar"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Contenedor del Tablero con Sumas al Estilo del PDF -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="14" Padding="14">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="gridTableroCompleto" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Se construye dinámicamente con matriz y etiquetas de suma -->
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Botón de Análisis -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="btnVerificar" Click="btnVerificar_Click" 
                                Style="{StaticResource BtnPrimarioStyle}" Height="46" FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                <TextBlock Text="Analizar y Validar Cuadrado Mágico" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- PANEL DE DIAGNÓSTICO -->
            <Border Grid.Column="1" Style="{StaticResource CupertinoCard}" Margin="12,0,0,0" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Diagnóstico del Cuadrado" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Tarjeta de Estado Principal -->
                        <Border x:Name="cardVeredicto" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" 
                                CornerRadius="14" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="lblEstadoBadge" Text="DIAGNÓSTICO POSITIVO" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                                <TextBlock x:Name="lblVeredicto" Text="¡Es Cuadro Mágico!" FontSize="20" FontWeight="Bold" Foreground="#047857" Margin="0,4,0,8"/>
                                <Border Background="#FFFFFF" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Constante Mágica (M):" FontSize="13" Foreground="#475569" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="lblConstanteMagica" Grid.Column="1" Text="15" FontSize="18" FontWeight="Bold" Foreground="#059669"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Resumen de Diagonales -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SUMAS DE DIAGONALES" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Diagonal Principal (\):" FontSize="13" Foreground="#334155"/>
                                    <TextBlock x:Name="lblDiagPrincipal" Grid.Column="1" Text="15" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Diagonal Secundaria (/):" FontSize="13" Foreground="#334155"/>
                                    <TextBlock x:Name="lblDiagSecundaria" Grid.Column="1" Text="15" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Explicación Detallada -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="MÉTODO UTILIZADO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="CuadroMagicoService.AnalizarCuadroMagico()" 
                                           FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,6"/>
                                <TextBlock x:Name="lblExplicacion" Text="Verifica sumas de filas, columnas y diagonales comparándolas con la referencia de la primera fila. Valida rango de 1 a N²." 
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BARRA INFERIOR -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Listo. Puedes probar con el ejemplo del PDF o generar automáticamente." 
                           FontSize="12" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
