<Window x:Class="Ejercicio6_ResumenVentas.frmResumenVentas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 6 - Resumen de Ventas (12 Meses x 5 Días)" 
        Height="820" Width="1160" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        MinWidth="1050" MinHeight="740">

    <Window.Resources>
        <Style x:Key="BtnPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecundarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#065F46"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D1FAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CupertinoCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.05" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CupertinoCard}" Margin="0,0,0,18" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Material Ventas / Gráfico -->
                        <Path Fill="#10B981" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/>
                        <TextBlock x:Name="lblTitulo" Text="Ejercicio 6: Resumen Anual de Ventas" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock x:Name="lblSubtitulo" Text="Arreglo de 12 meses x 5 días: calcula menor y mayor venta con su fecha, venta total y venta por día de la semana." 
                               FontSize="13" Foreground="#64748B" Margin="34,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRestaurar" Click="btnRestaurar_Click" 
                            Style="{StaticResource BtnSecundarioStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#065F46" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                            <TextBlock Text="Restaurar Tabla Original"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnCalcular" Click="btnCalcular_Click" 
                            Style="{StaticResource BtnPrimarioStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                            <TextBlock Text="Recalcular Ventas"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.2*"/>
                <ColumnDefinition Width="3.8*"/>
            </Grid.ColumnDefinitions>

            <!-- TABLA DE VENTAS 12x5 -->
            <Border Grid.Column="0" Style="{StaticResource CupertinoCard}" Margin="0,0,12,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tabla de Ventas por Mes y Día (Editable)" 
                               FontSize="14" FontWeight="Bold" Foreground="#334155" Margin="4,0,0,10"/>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="12" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid x:Name="gridVentas">
                                <!-- Se genera dinámicamente con los 12 meses y 5 días -->
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- RESULTADOS REQUERIDOS (INCISOS B, C, D, E) -->
            <Border Grid.Column="1" Style="{StaticResource CupertinoCard}" Margin="12,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Resultados del Análisis" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <!-- d) Venta Total -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="d) VENTA TOTAL GENERAL" FontSize="11" FontWeight="Bold" Foreground="#065F46" Opacity="0.8"/>
                                <TextBlock x:Name="lblVentaTotal" Text="$ 0.00" FontSize="26" FontWeight="Bold" Foreground="#047857" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- b) Menor Venta -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="b) MENOR VENTA REALIZADA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock x:Name="lblMenorMonto" Text="$ 3.00" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,0,10,0"/>
                                    <Border Background="#ECFDF5" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblMenorFecha" Text="Noviembre, Martes" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- c) Mayor Venta -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="c) MAYOR VENTA REALIZADA" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock x:Name="lblMayorMonto" Text="$ 82.00" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,0,10,0"/>
                                    <Border Background="#ECFDF5" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblMayorFecha" Text="Noviembre, Viernes" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- e) Venta por Día -->
                        <TextBlock Text="e) Ventas Acumuladas por Día:" FontSize="13" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8"/>
                        <StackPanel x:Name="panelVentasPorDia" Margin="0,0,0,14">
                            <!-- Se generan dinámicamente: Lunes: $ X.00, etc. -->
                        </StackPanel>

                        <!-- Explicación pedagógica -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="MÉTODO UTILIZADO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="ResumenVentasService.AnalizarVentas()" 
                                           FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,4"/>
                                <TextBlock Text="Recorre el arreglo bidimensional 12x5: halla mínimos y máximos registrando sus índices (mes y día), acumula la suma global y la suma por columnas para cada día de la semana." 
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Listo. Información de ventas cargada correctamente." 
                           FontSize="12" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
