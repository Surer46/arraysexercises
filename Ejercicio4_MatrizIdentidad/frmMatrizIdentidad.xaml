<Window x:Class="Ejercicio4_MatrizIdentidad.frmMatrizIdentidad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 4 - Generador de Matriz Identidad" 
        Height="740" Width="1040" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        MinWidth="900" MinHeight="660">

    <Window.Resources>
        <Style x:Key="BtnPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CupertinoCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.05" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{StaticResource CupertinoCard}" Margin="0,0,0,18" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Material Diagonal / Matriz -->
                        <Path Fill="#10B981" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0"
                              Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-2h2v2zm4-4h-2v-2h2v2zm4-4h-2V7h2v2z"/>
                        <TextBlock x:Name="lblTitulo" Text="Ejercicio 4: Matriz Identidad (Diagonal 1s, Demás 0s)" 
                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                    <TextBlock x:Name="lblSubtitulo" Text="Construye una matriz cuadrada de tamaño NxN donde los elementos cumplen: M[i,j]=1 si i=j, y 0 en cualquier otra posición." 
                               FontSize="13" Foreground="#64748B" Margin="34,4,0,0"/>
                </StackPanel>

                <!-- Selector de Tamaño N -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Dimensión N:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                    <Button x:Name="btnMenos" Click="btnMenos_Click" Content="−" Width="36" Height="36" 
                            FontSize="18" FontWeight="Bold" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="lblDimensionN" Text="5" Width="36" FontSize="18" FontWeight="Bold" 
                               Foreground="#059669" TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="btnMas" Click="btnMas_Click" Content="+" Width="36" Height="36" 
                            FontSize="18" FontWeight="Bold" Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <!-- MATRIZ VISUAL -->
            <Border Grid.Column="0" Style="{StaticResource CupertinoCard}" Margin="0,0,12,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Background="#ECFDF5" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock x:Name="lblMatrizInfo" Text="Matriz Identidad I₅ (5 x 5)" FontWeight="Bold" FontSize="13" Foreground="#047857"/>
                        </Border>
                        <TextBlock Text="Celdas de diagonal resaltadas en verde esmeralda" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="14" Padding="16">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="gridMatrizIdentidad" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Generado en código -->
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- PANEL DE MÉTRICAS Y PROPIEDADES -->
            <Border Grid.Column="1" Style="{StaticResource CupertinoCard}" Margin="12,0,0,0" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Propiedades de la Matriz" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>

                        <!-- Tarjeta Cuadrícula de Métricas -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total de Unos (Diagonal):" FontSize="13" Foreground="#065F46"/>
                                    <TextBlock x:Name="lblCantidadUnos" Grid.Column="1" Text="5" FontSize="15" FontWeight="Bold" Foreground="#047857"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total de Ceros (Fuera):" FontSize="13" Foreground="#065F46"/>
                                    <TextBlock x:Name="lblCantidadCeros" Grid.Column="1" Text="20" FontSize="15" FontWeight="Bold" Foreground="#047857"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total de Elementos (N²):" FontSize="13" Foreground="#065F46"/>
                                    <TextBlock x:Name="lblTotalElementos" Grid.Column="1" Text="25" FontSize="15" FontWeight="Bold" Foreground="#047857"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Propiedad Álgebra Lineal -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PROPIEDAD MATEMÁTICA" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBlock Text="Elemento Neutro Multiplicativo" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,4"/>
                                <TextBlock Text="Para cualquier matriz A compatible: A · I = I · A = A. Su determinante es siempre 1 y su traza es N." 
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Explicación del Método -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="MÉTODO UTILIZADO" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="MatrizIdentidadService.GenerarMatrizIdentidad(n)" 
                                           FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,6"/>
                                <TextBlock Text="Itera con dos ciclos for: si i == j asigna 1 (diagonal principal), de lo contrario asigna 0. Complejidad exacta O(N²)." 
                                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BARRA INFERIOR -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Listo. Usa los botones + y − para modificar el tamaño de la matriz." 
                           FontSize="12" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
