<Window x:Class="MenuPrincipal_Suite.frmMenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Principal - Práctica de Arreglos y Matrices | Estructura de Datos" 
        Height="860" Width="1220" 
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        MinWidth="1100" MinHeight="750">

    <Window.Resources>
        <!-- Estilo Botón Primario Verde Esmeralda -->
        <Style x:Key="BtnPrimarioStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Botón Peligro Salir -->
        <Style x:Key="BtnPeligroStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Tarjeta Cupertino -->
        <Style x:Key="CupertinoCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" Opacity="0.05" Direction="270" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Tarjeta de Ejercicio en Grid -->
        <Style x:Key="EjercicioCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" Opacity="0.04" Direction="270" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER PRINCIPAL -->
        <Border Grid.Row="0" Style="{StaticResource CupertinoCard}" Margin="0,0,0,18" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icono Material Apps / Grid -->
                        <Border Background="#ECFDF5" CornerRadius="12" Width="44" Height="44" Margin="0,0,14,0">
                            <Path Fill="#059669" Width="22" Height="22" Stretch="Uniform"
                                  Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                        </Border>
                        <StackPanel>
                            <TextBlock x:Name="lblTitulo" Text="Práctica de Arreglos y Matrices — Suite Completa" 
                                       FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="lblSubtitulo" Text="Universidad Tecnológica Metropolitana (UTM) • Asignatura: Estructura de Datos • Docente: Ing. Mirian Canché" 
                                       FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Botón Salir Global -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAbrirCarpeta" Click="btnAbrirCarpeta_Click" 
                            Style="{StaticResource BtnPrimarioStyle}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                            <TextBlock Text="Carpeta de Ejecutables"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSalir" Click="btnSalir_Click" Style="{StaticResource BtnPeligroStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
                            <TextBlock Text="Salir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GRID DE TARJETAS DE LOS 9 EJERCICIOS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="3" Margin="-8">

                <!-- TARJETA EJERCICIO 1 -->
                <Border Style="{StaticResource EjercicioCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 1" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Contador de Ceros por Renglón" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Matriz 5x5: cuenta y clasifica cuántos ceros aparecen en cada uno de los renglones." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje1" Click="btnEje1_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 1"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 2 -->
                <Border Style="{StaticResource EjercicioCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 2" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Cuadrado Mágico" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Verifica sumas de filas, columnas y diagonales y halla la constante mágica. Incluye generador." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje2" Click="btnEje2_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 2"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 3 -->
                <Border Style="{StaticResource EjercicioCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 3" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Operaciones con Matrices 2x2" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Calcula suma, resta, producto simple y división simple término a término entre matrices 2x2." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje3" Click="btnEje3_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 3"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 4 -->
                <Border Style="{StaticResource EjercicioCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 4" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Matriz Identidad NxN" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Llena una matriz con 1s en la diagonal principal y 0s en las demás posiciones. Tamaño dinámico." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje4" Click="btnEje4_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 4"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 5 -->
                <Border Style="{StaticResource EjercicioCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 5" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Matriz 5x10 (Arreglos A, B, C, D)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Almacena sumas y promedios por fila (A, B) y por columna (C, D) con el formato exacto del PDF." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje5" Click="btnEje5_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 5"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 6 -->
                <Border Style="{StaticResource EjercicioCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 6" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Resumen Anual de Ventas" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="Matriz 12x5: venta menor/mayor con mes y día, venta total y venta por día de la semana." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje6" Click="btnEje6_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 6"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 7 -->
                <Border Style="{StaticResource EjercicioCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 7" FontWeight="Bold" FontSize="11" Foreground="#047857"/>
                            </Border>
                            <TextBlock Text="Resumen de Calificaciones" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="12 alumnos x 3 parciales: promedios, récord alto/bajo, materias reprobadas y tabla de distribución." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje7" Click="btnEje7_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 7"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 8 (NIVEL ALTO) -->
                <Border Style="{StaticResource EjercicioCard}" BorderBrush="#A7F3D0" Background="#F0FDF4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#DCFCE7" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 8 (NIVEL ALTO 10/10)" FontWeight="Bold" FontSize="11" Foreground="#15803D"/>
                            </Border>
                            <TextBlock Text="Pathfinding en Matriz 2D" FontSize="16" FontWeight="Bold" Foreground="#065F46" Margin="0,0,0,4"/>
                            <TextBlock Text="Búsqueda de rutas óptimas en laberintos con obstáculos interactivos usando arreglos bidimensionales y BFS." FontSize="12" Foreground="#047857" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje8" Click="btnEje8_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 8"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- TARJETA EJERCICIO 9 (NIVEL ALTO) -->
                <Border Style="{StaticResource EjercicioCard}" BorderBrush="#A7F3D0" Background="#F0FDF4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Border Background="#DCFCE7" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="EJERCICIO 9 (NIVEL ALTO 10/10)" FontWeight="Bold" FontSize="11" Foreground="#15803D"/>
                            </Border>
                            <TextBlock Text="Multiplicación Matricial Avanzada" FontSize="16" FontWeight="Bold" Foreground="#065F46" Margin="0,0,0,4"/>
                            <TextBlock Text="Multiplicación matricial NxM por MxP O(n³), transpuesta y determinante recursivo por cofactores." FontSize="12" Foreground="#047857" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="btnEje9" Click="btnEje9_Click" Style="{StaticResource BtnPrimarioStyle}" Margin="0,14,0,0">
                            <TextBlock Text="Ejecutar Ejercicio 9"/>
                        </Button>
                    </Grid>
                </Border>

            </UniformGrid>
        </ScrollViewer>

        <!-- FOOTER / ESTADO -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Todos los 9 ejecutables EXE están listos y funcionales. Haz clic en cualquiera para iniciarlo." 
                           FontSize="12" Foreground="#64748B"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
